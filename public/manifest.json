{
  "manifest_version": 3,
  "name": "Frontend Audit Extension",
  "description": "Analyze the current page for SEO, accessibility, performance, and image issues.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Frontend Audit"
  },
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
